{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:editor": "tsx src/test/runEditorSuite.ts",
    "test:layout": "tsx src/test/runMinimalLayoutSuite.ts",
    "test:rtl": "tsx src/test/runRtlComponentSuite.tsx",
    "test:all": "tsx src/test/runEditorSuite.ts && tsx src/test/runMinimalLayoutSuite.ts && tsx src/test/runRtlComponentSuite.tsx",
    "lint": "oxlint --react-plugin src/",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
